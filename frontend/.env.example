# =====================================================================
# NIXIE website (Next.js) — copy to .env.local and fill in.
# On Vercel: Project → Settings → Environment Variables.
# Never commit .env.local.
# =====================================================================

# Where the Express backend runs. The browser never calls this directly:
# Next.js forwards every /api/... call to it (see next.config.mjs).
#   local:      http://localhost:4000
#   production: https://<your-service>.onrender.com   (no trailing slash)
BACKEND_URL=http://localhost:4000

# Public address of this website (used for link previews and share links).
#   local: http://localhost:3000   production: https://thenixie.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ImageKit host, only if you use a custom ImageKit domain. Default is fine.
NEXT_PUBLIC_IMAGE_HOST=ik.imagekit.io
