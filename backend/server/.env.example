# =====================================================================
# NIXIE backend — copy this file to .env and fill in the values.
# NEVER commit .env or put it in a zip. On Render, add these in
# Dashboard → your service → Environment.
# =====================================================================

NODE_ENV=development                 # "production" on Render
PORT=4000

# --- URLs -------------------------------------------------------------
FRONTEND_URL=http://localhost:3000   # production: https://thenixie.in (no trailing slash)
BACKEND_PUBLIC_URL=http://localhost:4000   # production: https://<your-service>.onrender.com
EXTRA_ALLOWED_ORIGINS=               # optional, comma-separated (e.g. https://www.thenixie.in)
TRUST_PROXY_HOPS=2                   # Vercel rewrite + Render proxy. Use 1 if you call Render directly.

# --- Database (Neon → Dashboard → Connection string, "Pooled") -------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Sessions ---------------------------------------------------------
# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later logs everyone out.
SESSION_SECRET=

# --- First admin (used only if no admin exists yet; min 12 characters) -
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google login (Google Cloud Console → APIs & Services → Credentials →
#     OAuth client ID → Web application). Add your site to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- Gemini (https://aistudio.google.com → Get API key) ---------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash        # change to the newest Flash model anytime

# --- Cashfree (Merchant Dashboard → Developers → API Keys) ------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox                 # "production" with live keys
CASHFREE_API_VERSION=2023-08-01

# --- Email (Gmail: turn on 2-Step Verification → create an App Password) -
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                           # the Gmail address emails are sent FROM
SMTP_PASS=                           # the 16-character App Password (not your Gmail password)
EMAIL_FROM_NAME=NIXIE

# --- ImageKit (Dashboard → Developer options → API keys) --------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_ROOT_FOLDER=/nixie          # images go to /nixie/analyses, /nixie/enquiries, /nixie/gallery

# --- Google Sheets pricing data (service account with read access to the sheet) -
GOOGLE_SHEET_ID=                     # the long id in the sheet's URL
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PRICING_REFRESH_INTERVAL_MINUTES=15

# --- Contact details shown in emails (change anytime) ----------------
CONTACT_EMAIL=aishwarya@thenixie.in
CONTACT_PHONE=1234567890
INSTAGRAM_URL=https://instagram.com/thenixie.in

# --- Safety cap: max guest analyses per day for the WHOLE site --------
GUEST_ANALYSIS_DAILY_CAP=300
